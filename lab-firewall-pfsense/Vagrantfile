# Perimeter-security lab with pfSense (VMware Workstation/Fusion).
#
# Topology (2 Linux VMs + pfSense INSTALLED MANUALLY, outside Vagrant):
#
#     [ client-lan ]         [ client-dmz ]
#      LAN 10.10.10.0/24      DMZ 10.10.20.0/24
#            \                     /
#             \                   /
#            [ pfSense ]  (firewall/gateway between the segments)
#          LAN IP 10.10.10.1     DMZ IP 10.10.20.1
#
# Each VM has two network interfaces:
#   eth0  NAT (VMnet8) - created automatically by Vagrant; gives the VMs SSH and internet.
#   eth1  private host-only network for its segment (LAN or DMZ) - the lab network.
#
# pfSense is NOT defined here. It is installed separately (from the ISO), with one
# interface on the LAN host-only network (final .1) and another on the DMZ host-only
# network (final .1). Until pfSense has its interfaces on those IPs and the rules are
# in place, routing between LAN and DMZ does NOT work: the VMs only reach the internet
# through Vagrant''s NAT (eth0). Traffic between LAN and DMZ only crosses pfSense.
#
# The lab uses LAN 10.10.10.0/24 and DMZ 10.10.20.0/24 (pfSense LAN 10.10.10.1,
# WAN 192.168.56.10 as a static IP on the NAT network). If these addresses clash
# with something on your network, adjust the variables below. Provisioning downloads
# packages through the NAT (eth0).
#
# Run:  vagrant up --provider=vmware_desktop

# =====================================================================
# NETWORK VARIABLES — ADJUST these to match the LAN/DMZ IPs configured
# on your pfSense. The .1 of each network is the IP of that pfSense
# interface (the segment gateway).
# =====================================================================
LAN_NET       = "10.10.10.0/24"   # LAN host-only network
LAN_GW        = "10.10.10.1"      # pfSense LAN interface IP (LAN gateway)
CLIENT_LAN_IP = "10.10.10.50"     # static IP of the client-lan VM

DMZ_NET       = "10.10.20.0/24"   # DMZ host-only network
DMZ_GW        = "10.10.20.1"      # pfSense DMZ interface IP (DMZ gateway)
CLIENT_DMZ_IP = "10.10.20.50"     # static IP of the client-dmz VM
# =====================================================================

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # ---- VM directory: VMware Workstation default folder ------------------
  # The VMs (clones) are created under "<home>/Documents/Virtual Machines"
  # instead of inside the repository. Resolved at runtime to stay portable
  # across machines. Can be overridden with the environment variable
  # VAGRANT_VMWARE_CLONE_DIRECTORY.
  require "fileutils"
  user_home = ENV["USERPROFILE"] || ENV["HOME"] || Dir.home
  vm_clone_dir = ENV["VAGRANT_VMWARE_CLONE_DIRECTORY"] ||
                 File.join(user_home, "Documents", "Virtual Machines")
  FileUtils.mkdir_p(vm_clone_dir)

  # ---- LAN client ------------------------------------------------------
  # eth1 on the LAN host-only network; route to the DMZ via LAN_GW (pfSense).
  # Serves a "client-lan" HTTP page on port 80 to test firewall rules.
  config.vm.define "client-lan" do |vm|
    vm.vm.box = "bento/ubuntu-24.04"
    vm.vm.hostname = "client-lan"
    vm.vm.network "private_network", ip: CLIENT_LAN_IP
    vm.vm.provider "vmware_desktop" do |p|
      p.clone_directory = vm_clone_dir
      p.vmx["memsize"]  = "768"
      p.vmx["numvcpus"] = "1"
      p.gui = false
    end
    # args: 1) gateway (pfSense LAN IP)  2) DMZ target (for tests/routes)
    vm.vm.provision "shell",
      path: "provision-client-lan.sh",
      args: [LAN_GW, CLIENT_DMZ_IP]
  end

  # ---- DMZ client ------------------------------------------------------
  # eth1 on the DMZ host-only network; route to the LAN via DMZ_GW (pfSense).
  # Serves a "client-dmz" HTTP page on port 80 to test firewall rules.
  config.vm.define "client-dmz" do |vm|
    vm.vm.box = "bento/ubuntu-24.04"
    vm.vm.hostname = "client-dmz"
    vm.vm.network "private_network", ip: CLIENT_DMZ_IP
    vm.vm.provider "vmware_desktop" do |p|
      p.clone_directory = vm_clone_dir
      p.vmx["memsize"]  = "768"
      p.vmx["numvcpus"] = "1"
      p.gui = false
    end
    # args: 1) gateway (pfSense DMZ IP)  2) LAN target (for tests/routes)
    vm.vm.provision "shell",
      path: "provision-client-dmz.sh",
      args: [DMZ_GW, CLIENT_LAN_IP]
  end
end